# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 运行期数据（书库索引 / 三级缓存 / 转换结果）。
# 只锚定 server 根目录，避免把源码包 app/cache/ 一起忽略（整个缓存层曾经
# 因此从未进入版本控制，修复无处提交）。
/cache/

# 个人配置（真实书库路径 / 密码）：仓库里只提交 config.example.yaml 模板
/config.yaml

# 字体文件体积大且版权各异，自行放入 assets/fonts/（见该目录 README）
/assets/fonts/*.otf
/assets/fonts/*.ttf
/assets/fonts/*.ttc
